{
  "include": ["backend"],
  "exclude": ["**/.venv", "**/__pycache__", "**/node_modules"],
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "extraPaths": ["backend"],

  // Django and DRF ship without type stubs, so strict mode only adds noise there
  "typeCheckingMode": "standard",

  // Strict only for the pure-Python logic modules, which import no Django
  "strict": [
    "backend/trips/risk.py",
    "backend/trips/geometry.py",
    "backend/trips/hos.py",
    "backend/trips/timeline.py"
  ]
}
